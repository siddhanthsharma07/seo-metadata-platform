# ---- Core ----------------------------------------------------------------
ENVIRONMENT=development                  # set to "production" in production (enforces a real SECRET_KEY)
DATABASE_URL=postgresql+psycopg://seo:seo@localhost:5432/seo_metadata
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=celery                      # "celery" (recommended) or "inline" (dev only: runs jobs in the API process)

# ---- Security ------------------------------------------------------------
SECRET_KEY=replace-with-output-of: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION=true                  # set false after creating your accounts
CORS_ORIGINS=http://localhost:3000

# ---- Crawler -------------------------------------------------------------
CRAWLER_USER_AGENT=SEOMetadataIntelligenceBot/1.0 (+metadata audit; respects robots.txt)
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_MAX_BYTES=5000000
# SSRF guard. Keep false: blocks localhost, private ranges and cloud metadata endpoints.
ALLOW_PRIVATE_NETWORKS=false
# Optional: path to a Chromium binary when Playwright's bundled browser is not installed
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium

# ---- AI providers (keys can also be saved, encrypted, in Settings) ------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_ANTHROPIC_MODEL=claude-opus-5-5
DEFAULT_OPENAI_MODEL=gpt-5
AI_REQUEST_TIMEOUT_SECONDS=180
